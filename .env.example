# Copy this file to .env (never commit .env, never share your key)

# true  = demo mode (simple keyword matching, no AI)
# false = real Gemini analysis (needs GEMINI_API_KEY below)
USE_MOCK=true

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. If you get a "model not found" error, pick a current model name
# from the Google AI Studio model list and put it here.
GEMINI_MODEL=gemini-2.5-flash
